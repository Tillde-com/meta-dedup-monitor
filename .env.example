# Meta Deduplication Monitor — environment variables (complete v1 surface)
# Copy to .env (or set in your deployment) and adjust. Every variable is optional
# unless noted; defaults shown are the built-in ones.

# Listen port (read only by src/index.ts).
PORT=8080

# Directory for events.db, fallback.ndjson, snapshot.db.
DATA_DIR=./data

# Instance label used in the report title and alert payloads.
MONITOR_NAME=meta-dedup-monitor

# If set, the ingest base path is /c/<secret> instead of /c.
COLLECT_PATH_SECRET=

# If set, the server channel requires the header X-Collector-Key: <key>.
INGEST_KEY=

# Guards /report, /api/*, /export.*. Empty = open.
# SAFETY: with NODE_ENV=production and an empty ADMIN_TOKEN the process refuses
# to start unless ALLOW_INSECURE=1.
ADMIN_TOKEN=

# Request bodies larger than this many bytes are rejected with 413.
MAX_BODY_BYTES=1000000

# Purge raw requests/events rows older than this many days. 0 disables purging.
RAW_RETENTION_DAYS=14

# Alert threshold on the server dedup rate, e.g. 0.8. Empty = alerting disabled.
ALERT_THRESHOLD=

# Alert evaluation window, in hours.
ALERT_WINDOW_HOURS=24

# Alert evaluation cadence, in minutes.
ALERT_CHECK_MINUTES=15

# Webhook target for alert notifications (POST, JSON body).
ALERT_WEBHOOK_URL=

# Optional email delivery via Resend.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Set to 1 to allow a production start with an empty ADMIN_TOKEN.
ALLOW_INSECURE=
